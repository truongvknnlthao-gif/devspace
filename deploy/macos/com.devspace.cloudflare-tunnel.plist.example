<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.devspace.cloudflare-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLOUDFLARED_BINARY__</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>__HOME__/.cloudflared/config-devspace.yml</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/devspace/logs/cloudflared.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/devspace/logs/cloudflared-error.log</string>
</dict>
</plist>
